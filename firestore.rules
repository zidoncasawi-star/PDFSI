rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist. There is no self-service way to become an admin: the
    // project owner adds a document here (any content, even empty) named
    // after a user's uid, via the Firebase console, after that user has
    // signed up normally through /app.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Each web app user's profile + all their data (documents, templates,
    // audit log) lives under users/{uid}. Owners can read/write their own
    // subtree; admins can read everyone's (for the /admin dashboard).
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public contact form (Contact us page). Anyone can submit a message
    // (shape-checked, capped length to deter abuse); only admins can read
    // them back, and nothing can ever be edited or deleted from the client.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 320 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Ephemeral "sign on your phone" handoff: the desktop/web app (signed
    // in) creates a session with an unguessable random ID and shows it as a
    // QR code; the phone that scans it — deliberately NOT signed in, to
    // keep that flow frictionless — draws a signature and flips the same
    // session from pending -> completed. The random ID acts as a one-time
    // capability token, so no further auth is required for that single
    // state transition.
    match /signatureSessions/{sessionId} {
      allow create: if request.auth != null &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid;
      allow read: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow update: if resource.data.status == 'pending' &&
        request.resource.data.status == 'completed' &&
        request.resource.data.dataUrl is string &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Anonymous, increment-only counter for the public Download page's
    // "Download now" button, so the admin dashboard can see interest even
    // from visitors who never sign up.
    match /stats/downloads {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // One doc per device that has ever launched the Windows app, keyed by a
    // random per-install ID generated locally (main.js's settings.deviceId)
    // — lets the admin dashboard count real installs without requiring
    // sign-in first.
    match /installs/{deviceId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['platform', 'firstSeenAt', 'lastSeenAt']) &&
        request.resource.data.platform is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'appVersion', 'ownerUid']);
      allow delete: if false;
    }

    // Lightweight presence heartbeat: signed-in users (desktop or web) write
    // their own doc every ~25s while the app is open; the admin dashboard
    // treats a recent lastActiveAt as "currently online". Not authoritative
    // (no clean offline detection), just a staleness check.
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Ad network configuration (AdSense for web/desktop, AdMob IDs reserved
    // for a future native phone app), managed from the admin dashboard's
    // Ads page. Publicly readable — every app (signed in or not) needs
    // these IDs to render ads, and they're not secret (visible in any page
    // that loads them anyway). Only admins can change them.
    match /settings/ads {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Windows app version gate: admin sets the latest version, download URL
    // and whether it's a forced (blocking) update from the admin
    // dashboard's App Update page. Publicly readable — the desktop app
    // checks this before the user is even signed in.
    match /settings/appVersion {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
